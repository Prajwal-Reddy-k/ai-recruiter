{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AIRecruiterDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "AIRecruiter.API",
    "Audience": "AIRecruiter.Client",
    "ExpiryMinutes": 120
  },
  "ResumeStorage": {
    "LocalRootPath": "App_Data/Resumes",
    "MaxSizeBytes": 5242880
  },
  "Avatar": {
    "MaxSizeBytes": 5242880,
    "MaxDimensionPx": 512
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Adzuna": {
    "AppId": "",
    "AppKey": "",
    "Country": "gb"
  },
  "Nominatim": {
    "ContactEmail": "you@example.com"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "SenderEmail": "",
    "SenderName": "AI Recruiter",
    "EnableSsl": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "General": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Export": { "PermitLimit": 10, "WindowSeconds": 60 }
  }
}
