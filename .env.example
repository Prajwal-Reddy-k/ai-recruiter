# Copy this file to .env (gitignored) and fill in real local values before running
# `docker compose up --build`. Never commit the real .env file.

# SQL Server "sa" password used by the sqlserver container — must satisfy SQL Server's
# complexity policy (8+ chars, upper+lower+digit+symbol).
SA_PASSWORD=Ch4ngeThisP@ssword!

# JWT signing secret for the api container — must be at least 32 characters
# (enforced at startup by JwtOptionsValidator). Generate a random one for real use.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
